# PayPal REST sandbox credentials (create these in the PayPal Developer Dashboard)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PORT=3000
HOST=127.0.0.1

# Optional Groq semantic verification.
# If omitted, the demo uses deterministic checks only.
# When configured, Groq errors or ambiguous results route to REVIEW (no capture).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
